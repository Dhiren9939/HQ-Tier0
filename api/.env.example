# Copy to .env (git-ignored) and fill in real values. Loaded by ApiApplication at startup
# into JVM system properties - application-dev.properties references these as ${VAR_NAME}.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Base64-encoded HMAC-SHA256 key, 256 bits. Generate one with: openssl rand -base64 32
JWT_SECRET=

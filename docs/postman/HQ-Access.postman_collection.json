{
  "info": {
    "name": "HQ Access (API keys)",
    "description": "User-facing API key endpoints. Run the User requests in order: Create stores apiKeyId/accessId, then Get, rename, revoke a scope and Delete; once deleted, reads and changes return 404. Every change applies at once (HQ is the source of truth): there is no pending/confirm/reject handshake, no cancel and no dismiss. `status` is ACTIVE or EXPIRED; a deleted key is not returned at all. `userId` comes from the URL until authentication exists.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "userId", "value": "00000000-0000-0000-0000-000000000001" },
    { "key": "apiKeyId", "value": "" },
    { "key": "accessId", "value": "" },
    { "key": "accessSecret", "value": "" }
  ],
  "item": [
    {
      "name": "User",
      "item": [
        {
          "name": "Create API key",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('apiKeyId', body.apiKeyId);",
                  "pm.collectionVariables.set('accessId', body.accessId);",
                  "pm.collectionVariables.set('accessSecret', body.accessSecret);",
                  "pm.test('ACTIVE at once; the secret is returned once', () => {",
                  "  pm.expect(body.accessSecret).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.status).to.eql('ACTIVE');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/user/{{userId}}/apikey",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"deploy-key\",\n  \"expiry\": \"ONE_MONTH\",\n  \"permissions\": {\n    \"INGESTION\": \"WRITE\",\n    \"TENANT\": \"READ_WRITE\"\n  }\n}"
            },
            "description": "expiry: ONE_DAY | ONE_MONTH | NEVER. Scopes: INGESTION (WRITE), TENANT and CHANNEL (READ, WRITE, READ_WRITE). A missing scope means NONE. The key is ACTIVE immediately and its creation event is already in the outbox."
          }
        },
        {
          "name": "Get API key",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('status is ACTIVE or EXPIRED, every scope is listed, no secret', () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(['ACTIVE', 'EXPIRED']).to.include(b.status);",
                  "  pm.expect(Object.keys(b.permissions)).to.have.members(['INGESTION', 'TENANT', 'CHANNEL']);",
                  "  pm.expect(b).to.not.have.property('accessSecret');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/user/{{userId}}/apikey/{{apiKeyId}}"
          }
        },
        {
          "name": "Update API key (rename, change expiry)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('applied at once', () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.apiKeyName).to.eql('renamed-key');",
                  "  pm.expect(b.status).to.eql('ACTIVE');",
                  "  pm.expect(b.expiresAt).to.be.null;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/user/{{userId}}/apikey/{{apiKeyId}}",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"renamed-key\",\n  \"expiry\": \"NEVER\"\n}" },
            "description": "Partial update. Only the fields you send change; an update that changes nothing is a no-op (no revision bump, no event)."
          }
        },
        {
          "name": "Update permissions (remove TENANT, keep the rest)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('only TENANT was revoked', () => {",
                  "  const p = pm.response.json().permissions;",
                  "  pm.expect(p.TENANT).to.eql('NONE');",
                  "  pm.expect(p.INGESTION).to.eql('WRITE');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/user/{{userId}}/apikey/{{apiKeyId}}",
            "body": { "mode": "raw", "raw": "{\n  \"permissions\": {\n    \"TENANT\": \"NONE\"\n  }\n}" },
            "description": "NONE removes the scope; scopes not listed are unchanged; a null level means unchanged."
          }
        },
        {
          "name": "Delete API key",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('204 No Content', () => pm.response.to.have.status(204));"]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/v1/user/{{userId}}/apikey/{{apiKeyId}}",
            "description": "Deletes the key outright: the row is removed and the apiKey.projection.delete event is written to the outbox in the same transaction. There is no tombstone and nothing to dismiss; the Access ID can be issued again immediately."
          }
        },
        {
          "name": "Get the deleted API key (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
                  "pm.test('the key is gone, not a tombstone', () => pm.expect(pm.response.json().code).to.eql('API_KEY_NOT_FOUND'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/user/{{userId}}/apikey/{{apiKeyId}}",
            "description": "Run after Delete: a deleted key is indistinguishable from one that never existed."
          }
        }
      ]
    },
    {
      "name": "Error cases",
      "item": [
        {
          "name": "Create with invalid level for scope (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('machine code names the cause', () => pm.expect(pm.response.json().code).to.eql('INVALID_SCOPE_LEVEL'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/user/{{userId}}/apikey",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"bad\",\n  \"expiry\": \"NEVER\",\n  \"permissions\": { \"INGESTION\": \"READ_WRITE\" }\n}" },
            "description": "INGESTION accepts only NONE and WRITE."
          }
        },
        {
          "name": "Create without a name (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('every field error is listed with its own code', () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.code).to.eql('VALIDATION_FAILED');",
                  "  pm.expect(b.errors.some(e => e.field === 'name' && e.code === 'NAME_REQUIRED')).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/user/{{userId}}/apikey",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"\",\n  \"expiry\": \"NEVER\"\n}" }
          }
        },
        {
          "name": "Malformed JSON body (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('code is REQUEST_BODY_NOT_JSON', () => pm.expect(pm.response.json().code).to.eql('REQUEST_BODY_NOT_JSON'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/user/{{userId}}/apikey",
            "body": { "mode": "raw", "raw": "{oops" }
          }
        },
        {
          "name": "Get unknown key (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
                  "pm.test('code is API_KEY_NOT_FOUND', () => pm.expect(pm.response.json().code).to.eql('API_KEY_NOT_FOUND'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/user/{{userId}}/apikey/11111111-1111-1111-1111-111111111111"
          }
        },
        {
          "name": "Update another user's key (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('404 Not Found', () => pm.response.to.have.status(404));"]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/user/00000000-0000-0000-0000-000000000099/apikey/{{apiKeyId}}",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"stolen\"\n}" },
            "description": "Another user's key looks exactly like a missing one."
          }
        },
        {
          "name": "Wrong method on the key (405)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('405 Method Not Allowed', () => pm.response.to.have.status(405));",
                  "pm.test('code is METHOD_NOT_ALLOWED', () => pm.expect(pm.response.json().code).to.eql('METHOD_NOT_ALLOWED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [],
            "url": "{{baseUrl}}/api/v1/user/{{userId}}/apikey/{{apiKeyId}}"
          }
        }
      ]
    }
  ]
}
